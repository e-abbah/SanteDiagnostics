<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="santediagnosticsltd.controllers.CustomerDashboardController">

    <!-- TOP NAV -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="20"
              style="-fx-background-color: #1a1a2e; -fx-padding: 0 30 0 30;">
            <Label text="🏥 Sante Diagnostics"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome"
                   style="-fx-text-fill: white; -fx-font-size: 13px;"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="200" spacing="5"
              style="-fx-background-color: #f1f5f9; -fx-padding: 20 10 20 10;">
            <Button text="🏠  Home" maxWidth="Infinity"
                    onAction="#showHome" styleClass="primary-btn"/>
            <Button text="🧪  Browse Tests" maxWidth="Infinity"
                    onAction="#showBrowseTests"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-cursor: hand; -fx-padding: 10; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📋  My Orders" maxWidth="Infinity"
                    onAction="#showMyOrders"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-cursor: hand; -fx-padding: 10; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📊  My Results" maxWidth="Infinity"
                    onAction="#showMyResults"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-cursor: hand; -fx-padding: 10; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <Pane fx:id="contentPane" style="-fx-padding: 20;"/>
    </center>

</BorderPane>