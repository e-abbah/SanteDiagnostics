<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="santediagnosticsltd.controllers.LoginController">

    <left>
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="350.0"
              spacing="10" styleClass="brand-panel">
            <padding>
                <Insets top="40" bottom="40" left="30" right="30"/>
            </padding>
            <children>
                <Label text="🏥" style="-fx-font-size: 48px;"/>
                <Label text="Sante Diagnostics" styleClass="brand-name"/>
                <Label text="Laboratory Information System"
                       styleClass="brand-sub" wrapText="true"
                       style="-fx-alignment: center;"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" prefWidth="550.0" spacing="14"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="60" bottom="60" left="80" right="80"/>
            </padding>
            <children>

                <Label text="Sign In"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Welcome back to Sante Diagnostics"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>

                <Region prefHeight="10"/>

                <Label text="Email" styleClass="field-label" maxWidth="Infinity"/>
                <TextField fx:id="emailField" promptText="Enter your email"
                           styleClass="form-field" maxWidth="Infinity"/>

                <Label text="Password" styleClass="field-label" maxWidth="Infinity"/>
                <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
                    <children>
                        <PasswordField fx:id="passwordField" promptText="Enter your password"
                                       styleClass="form-field" maxWidth="Infinity"/>
                        <TextField fx:id="passwordTextField" promptText="Enter your password"
                                   styleClass="form-field" maxWidth="Infinity" visible="false"/>
                        <Button fx:id="togglePasswordBtn" text="👁" onAction="#togglePasswordVisibility"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #6b7280; -fx-font-size: 14px;">
                            <StackPane.margin>
                                <Insets right="10.0"/>
                            </StackPane.margin>
                        </Button>
                    </children>
                </StackPane>

                <Label fx:id="errorLabel" text="" styleClass="error-label" maxWidth="Infinity"/>

<!--                <Label text="Forgot Password?"
                       styleClass="link-label"
                       style="-fx-font-size: 12px;" maxWidth="Infinity"/>-->
                    <Label text="Forgot Password?"
       styleClass="link-label"
       onMouseClicked="#handleForgotPassword"
       style="-fx-font-size: 12px; -fx-cursor: hand;" maxWidth="Infinity"/>

                <Region prefHeight="5"/>

                <Button fx:id="loginBtn" text="Continue"
                        styleClass="primary-btn" maxWidth="Infinity"
                        onAction="#handleLogin"/>

                <Region prefHeight="5"/>

                <HBox alignment="CENTER" spacing="10">
                    <Region HBox.hgrow="ALWAYS"
                            style="-fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;"/>
                    <Label text="or" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
                    <Region HBox.hgrow="ALWAYS"
                            style="-fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;"/>
                </HBox>

                <Region prefHeight="5"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Don't have an account?"
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                    <Label text="Signup" styleClass="link-label"
                           onMouseClicked="#goToSignup"/>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>