<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="santediagnosticsltd.controllers.SignupController">

    <left>
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="350.0"
              spacing="10" styleClass="brand-panel">
            <padding>
                <Insets top="40" bottom="40" left="30" right="30"/>
            </padding>
            <children>
                <Label text="🏥" style="-fx-font-size: 48px;"/>
                <Label text="Sante Diagnostics" styleClass="brand-name"/>
                <Label text="Laboratory Information System"
                       styleClass="brand-sub" wrapText="true"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" prefWidth="550.0" spacing="12"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="40" bottom="40" left="80" right="80"/>
            </padding>
            <children>

                <Label text="Create Account"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Register as a new customer"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>

                <Region prefHeight="8"/>

                <Label text="First Name" styleClass="field-label" maxWidth="Infinity"/>
                <TextField fx:id="firstNameField" promptText="Enter your first name"
                           styleClass="form-field" maxWidth="Infinity"/>

                <Label text="Last Name" styleClass="field-label" maxWidth="Infinity"/>
                <TextField fx:id="lastNameField" promptText="Enter your last name"
                           styleClass="form-field" maxWidth="Infinity"/>

                <Label text="Email" styleClass="field-label" maxWidth="Infinity"/>
                <TextField fx:id="emailField" promptText="Enter your email"
                           styleClass="form-field" maxWidth="Infinity"/>

                <Label text="Password" styleClass="field-label" maxWidth="Infinity"/>
                <PasswordField fx:id="passwordField" promptText="Create a password"
                               styleClass="form-field" maxWidth="Infinity"/>

                <Label fx:id="errorLabel" text="" styleClass="error-label"
                       maxWidth="Infinity"/>

                <Region prefHeight="5"/>

                <Button text="Create Account" styleClass="primary-btn"
                        maxWidth="Infinity" onAction="#handleSignup"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Already have an account?"
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                    <Label text="Sign In" styleClass="link-label"
                           onMouseClicked="#goToLogin"/>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>