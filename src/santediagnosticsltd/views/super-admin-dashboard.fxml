<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    LAYOUT EXPLANATION:
    BorderPane divides the screen into 5 zones: top, left, center, right, bottom.
    We use 3 zones:
      - top    → the dark navbar (logo + welcome + logout)
      - left   → the sidebar (navigation buttons)
      - center → the contentPane (dynamically filled by the controller)
-->
<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="santediagnosticsltd.controllers.SuperAdminDashboardController">

    <!-- ═══════════════════════════════════════════════
         TOP NAVBAR
         Same #1a1a2e dark navy as the login brand panel
         ═══════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="20"
              style="-fx-background-color: #1a1a2e; -fx-padding: 0 30 0 30;">

            <!-- Brand logo + name on the left -->
            <Label text="🏥 Sante Diagnostics"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <!-- Role badge -->
            <Label text="SUPER ADMIN"
                   style="-fx-text-fill: #f59e0b; -fx-font-size: 11px; -fx-font-weight: bold;
                          -fx-background-color: rgba(245,158,11,0.15); -fx-background-radius: 4;
                          -fx-padding: 3 8 3 8;"/>

            <!-- Spacer pushes the right side items to the far right -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Welcome message — fx:id lets the controller update this text -->
            <Label fx:id="welcomeLabel" text="Welcome"
                   style="-fx-text-fill: white; -fx-font-size: 13px;"/>

            <!-- Logout button -->
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14 6 14;"/>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════
         LEFT SIDEBAR
         Each Button calls a method in the controller
         via onAction="#methodName"
         ═══════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="210" spacing="4"
              style="-fx-background-color: #f1f5f9; -fx-padding: 20 10 20 10;">

            <!-- Section label -->
            <Label text="DASHBOARD"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-padding: 0 0 6 8;"/>

            <!-- Home button — uses the primary blue style from styles.css -->
            <Button text="🏠  Overview" maxWidth="Infinity"
                    onAction="#showHome" styleClass="primary-btn"/>

            <!-- Separator line between sections -->
            <Separator style="-fx-padding: 6 0 6 0;"/>

            <Label text="CONFIGURATION"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-padding: 0 0 6 8;"/>

            <!--
                Transparent sidebar buttons — same pattern as customer dashboard.
                -fx-alignment: CENTER_LEFT makes the text align to the left side.
            -->
            <Button text="🧪  Test Builder" maxWidth="Infinity"
                    onAction="#showTestBuilder"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-cursor: hand; -fx-padding: 10; -fx-alignment: CENTER_LEFT;
                           -fx-font-size: 13px;"/>

            <Separator style="-fx-padding: 6 0 6 0;"/>

            <Label text="OPERATIONS"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-padding: 0 0 6 8;"/>

            <Button text="📋  Test Requests" maxWidth="Infinity"
                    onAction="#showTestRequests"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-cursor: hand; -fx-padding: 10; -fx-alignment: CENTER_LEFT;
                           -fx-font-size: 13px;"/>

            <Button text="👤  Create Account" maxWidth="Infinity"
                    onAction="#showCreateAccount"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-cursor: hand; -fx-padding: 10; -fx-alignment: CENTER_LEFT;
                           -fx-font-size: 13px;"/>

            <Separator style="-fx-padding: 6 0 6 0;"/>

            <Label text="GOVERNANCE"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-padding: 0 0 6 8;"/>

            <Button text="🔍  Audit Trail" maxWidth="Infinity"
                    onAction="#showAuditTrail"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-cursor: hand; -fx-padding: 10; -fx-alignment: CENTER_LEFT;
                           -fx-font-size: 13px;"/>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════
         CENTER CONTENT AREA
         This Pane is empty in FXML — the controller
         builds and swaps content here dynamically
         at runtime using Java code.
         ═══════════════════════════════════════════════ -->
    <center>
        <Pane fx:id="contentPane" style="-fx-background-color: #f8f9fa;"/>
    </center>

</BorderPane>
